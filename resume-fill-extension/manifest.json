{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "通用简历填写",
  "description": "本机简历资料卡，预览并填入当前招聘表单的空白项。",
  "version": "1.0.2",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {"default_popup": "popup.html", "default_title": "通用简历填写"},
  "options_ui": {"page": "options.html", "open_in_tab": true}
}
